---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Ruben Perez — Resume Portfolio" description="Customer Support · Cybersecurity · AI Training · Data Operations · Insurance">
  <Header />
  
  <main class="min-h-screen">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-br from-navy-900 via-navy-800 to-teal-900 text-white">
      <div class="max-w-6xl mx-auto px-4 py-24 sm:py-32">
        <div class="text-center">
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight mb-6">
            Ruben Perez
          </h1>
          <p class="text-xl sm:text-2xl text-teal-100 mb-8 max-w-3xl mx-auto leading-relaxed">
            Customer Support · Cybersecurity · AI Training · Data Operations · Insurance
          </p>
          <p class="text-lg sm:text-xl text-teal-200/80 max-w-2xl mx-auto mb-12">
            Six tailored resumes. One portfolio. Built for the roles you're hiring for.
          </p>
          <div class="flex flex-wrap justify-center gap-4 mb-16">
            <a href="/resumes" class="bg-white text-navy-900 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
              View Resumes →
            </a>
            <a href="/projects" class="bg-transparent border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/10 transition-colors">
              View Projects
            </a>
          </div>
          
          <!-- Cert badges -->
          <div class="flex flex-wrap justify-center gap-3 text-sm">
            <span class="bg-white/10 border border-white/20 px-4 py-2 rounded-full">IBM Generative AI Engineering</span>
            <span class="bg-white/10 border border-white/20 px-4 py-2 rounded-full">Google AI Professional</span>
            <span class="bg-white/10 border border-white/20 px-4 py-2 rounded-full">Google Cybersecurity Professional</span>
            <span class="bg-white/10 border border-white/20 px-4 py-2 rounded-full">Introduction to AWS</span>
            <span class="bg-teal-500/20 border border-teal-500/30 px-4 py-2 rounded-full">Licensed Health & Life Insurance Agent</span>
          </div>
        </div>
      </div>
      
      <!-- Decorative elements -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-navy-500/20 rounded-full blur-3xl"></div>
      </div>
    </section>

    <!-- About -->
    <section class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 mb-6">About</h2>
            <div class="prose prose-navy max-w-none text-gray-700 leading-relaxed">
              <p class="mb-4 text-lg">
                Customer support professional with 5+ years across healthcare, pharmacy, government relief, and tech.
              </p>
              <p class="mb-4">
                Pivoting into cybersecurity (<strong>Google Cybersecurity Certificate</strong>) and AI training (<strong>IBM Generative AI Engineering</strong>, <strong>Google AI Certificate</strong>).
              </p>
              <p class="mb-4">
                Bilingual English/Spanish. Remote-first. HIPAA-compliant. Licensed Health & Life Insurance Agent.
              </p>
              <p>
                Currently building: <a href="https://github.com/XDEMONXHEARTX/prompt-guard" target="_blank" class="text-teal-600 hover:underline">Prompt Guard</a> (LLM guardrails), <a href="https://github.com/XDEMONXHEARTX/soc-blueteam-lab" target="_blank" class="text-teal-600 hover:underline">SOC Blue Team Lab</a> (Sigma detections + incident response).
              </p>
            </div>
          </div>
          
          <div class="space-y-4">
            <a href="https://github.com/XDEMONXHEARTX" target="_blank" rel="noopener" class="inline-flex items-center gap-3 px-6 py-4 bg-navy-900 text-white rounded-lg hover:bg-navy-800 transition-colors group w-full sm:w-auto">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              <span class="font-medium">GitHub</span>
              <svg class="w-4 h-4 ml-auto group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
            
            <a href="https://linkedin.com/in/joshua-perez-696849183" target="_blank" rel="noopener" class="inline-flex items-center gap-3 px-6 py-4 bg-white border border-gray-300 text-navy-900 rounded-lg hover:bg-gray-50 transition-colors group w-full sm:w-auto">
              <svg class="w-6 h-6 text-teal-600" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 21.571V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              <span class="font-medium">LinkedIn</span>
              <svg class="w-4 h-4 ml-auto group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
            
            <a href="mailto:hire@xdemonxheartx.dev" class="inline-flex items-center gap-3 px-6 py-4 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors group w-full sm:w-auto">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span class="font-medium">Contact</span>
              <svg class="w-4 h-4 ml-auto group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Resumes -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-6xl mx-auto px-4">
        <header class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 mb-4">Featured Resumes</h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Six tailored resumes for distinct role clusters. Each generated from a single source of truth with role-aware skills, certifications, and project highlights.
          </p>
        </header>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- AI Trainer -->
          <article class="bg-white rounded-xl border border-gray-200 p-6 hover:border-teal-300 hover:shadow-lg transition-all duration-300">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-teal-100 text-teal-800 text-xs font-semibold px-3 py-1 rounded-full">AI Training</span>
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-3">AI Trainer (100hr)</h3>
            <p class="text-gray-600 mb-4 leading-relaxed">LLM prompt/response evaluation, RLHF data annotation, instruction-following assessment, safety evaluation, factual accuracy verification.</p>
            <ul class="space-y-1 text-sm text-gray-600 mb-6">
              <li>• LLM Fine-Tuning, Transformers, RAG & LangChain</li>
              <li>• Prompt/Response Evaluation, NLP Foundational Models</li>
              <li>• IBM GenAI Eng, Google AI Cert, Google Cybersecurity Cert</li>
            </ul>
            <a href="/resumes/ai-trainer" class="inline-flex items-center gap-2 text-teal-600 font-semibold hover:text-teal-700">
              View Details →
            </a>
          </article>

          <!-- Cyber SOC -->
          <article class="bg-white rounded-xl border border-gray-200 p-6 hover:border-teal-300 hover:shadow-lg transition-all duration-300">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-navy-100 text-navy-800 text-xs font-semibold px-3 py-1 rounded-full">Cybersecurity</span>
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-3">Entry Cyber SOC Analyst</h3>
            <p class="text-gray-600 mb-4 leading-relaxed">Google Cybersecurity Certificate + hands-on blue team lab: Sigma detections, SIEM log analysis, incident response writeups (brute-force, impossible travel, credential stuffing).</p>
            <ul class="space-y-1 text-sm text-gray-600 mb-6">
              <li>• Sigma Rules, Splunk/Elastic, Python Automation</li>
              <li>• Incident Response, Threat Detection, Risk & Compliance</li>
              <li>• Google Cybersecurity Cert, AWS Intro, IBM GenAI Eng</li>
            </ul>
            <a href="/resumes/entry-cyber-soc" class="inline-flex items-center gap-2 text-teal-600 font-semibold hover:text-teal-700">
              View Details →
            </a>
          </article>

          <!-- Insurance -->
          <article class="bg-white rounded-xl border border-gray-200 p-6 hover:border-teal-300 hover:shadow-lg transition-all duration-300">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-amber-100 text-amber-800 text-xs font-semibold px-3 py-1 rounded-full">Insurance</span>
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-3">Retirement Benefits Specialist</h3>
            <p class="text-gray-600 mb-4 leading-relaxed">Licensed Health & Life Agent. Medicare/Medicaid eligibility, HIPAA-compliant member support, benefits enrollment (Med/Den/Vis), policy explanation, high-volume case management.</p>
            <ul class="space-y-1 text-sm text-gray-600 mb-6">
              <li>• Licensed Health & Life Agent, HIPAA Compliance</li>
              <li>• Benefits Enrollment, Policy Explanation, Client Onboarding</li>
              <li>• Google Cybersecurity Cert, AWS Intro, IBM GenAI Eng</li>
            </ul>
            <a href="/resumes/retirement-benefits" class="inline-flex items-center gap-2 text-teal-600 font-semibold hover:text-teal-700">
              View Details →
            </a>
          </article>
        </div>
        
        <div class="text-center mt-10">
          <a href="/resumes" class="inline-flex items-center gap-2 bg-navy-900 text-white px-8 py-4 rounded-lg font-semibold hover:bg-navy-800 transition-colors">
            View All 6 Resumes →
          </a>
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <header class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 mb-4">Featured Projects</h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">Open source tools at the intersection of AI security, cybersecurity, and systems engineering.</p>
        </header>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Prompt Guard -->
          <article class="bg-white rounded-xl border border-gray-200 p-6 hover:border-teal-300 hover:shadow-lg transition-all duration-300 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class="bg-red-100 text-red-800 text-xs font-semibold px-3 py-1 rounded-full">AI Security</span>
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">Prompt Guard</h3>
            <p class="text-gray-600 mb-4 flex-1">Lightweight prompt injection detection & LLM guardrail library. Regex-based detection for direct/indirect injection, PII, encoding obfuscation. <1ms latency.</p>
            <div class="flex gap-2">
              <a href="https://github.com/XDEMONXHEARTX/prompt-guard" target="_blank" rel="noopener" class="text-sm text-teal-600 hover:underline">GitHub</a>
            </div>
          </article>

          <!-- LLM Evaluator -->
          <article class="bg-white rounded-xl border border-gray-200 p-6 hover:border-teal-300 hover:shadow-lg transition-all duration-300 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class="bg-purple-100 text-purple-800 text-xs font-semibold px-3 py-1 rounded-full">LLM Evaluation</span>
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">LLM Evaluator</h3>
            <p class="text-gray-600 mb-4 flex-1">Model output scoring on correctness, faithfulness, safety. The skill AI-training contracts pay for. Offline evaluation pipeline.</p>
            <div class="flex gap-2">
              <a href="https://github.com/XDEMONXHEARTX/llm-evaluator" target="_blank" rel="noopener" class="text-sm text-teal-600 hover:underline">GitHub</a>
            </div>
          </article>

          <!-- SOC Blue Team Lab -->
          <article class="bg-white rounded-xl border border-gray-200 p-6 hover:border-teal-300 hover:shadow-lg transition-all duration-300 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-3 py-1 rounded-full">Blue Team</span>
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">SOC Blue Team Lab</h3>
            <p class="text-gray-600 mb-4 flex-1">Sigma detections + log analyzer + full incident writeups (brute-force, impossible travel, credential stuffing). Portfolio piece for blue team roles.</p>
            <div class="flex gap-2">
              <a href="https://github.com/XDEMONXHEARTX/soc-blueteam-lab" target="_blank" rel="noopener" class="text-sm text-teal-600 hover:underline">GitHub</a>
            </div>
          </article>

          <!-- Cyber Chef Lite -->
          <article class="bg-white rounded-xl border border-gray-200 p-6 hover:border-teal-300 hover:shadow-lg transition-all duration-300 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class="bg-green-100 text-green-800 text-xs font-semibold px-3 py-1 rounded-full">Tools</span>
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">Cyber Chef Lite</h3>
            <p class="text-gray-600 mb-4 flex-1">Offline encoding/crypto Swiss Army knife: base64, hex, hash, XOR, ROT13. CyberChef-inspired, runs anywhere Python runs.</p>
            <div class="flex gap-2">
              <a href="https://github.com/XDEMONXHEARTX/cyber-chef-lite" target="_blank" rel="noopener" class="text-sm text-teal-600 hover:underline">GitHub</a>
            </div>
          </article>

          <!-- Rate Limiter API -->
          <article class="bg-white rounded-xl border border-gray-200 p-6 hover:border-teal-300 hover:shadow-lg transition-all duration-300 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class="bg-orange-100 text-orange-800 text-xs font-semibold px-3 py-1 rounded-full">Systems</span>
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">Rate Limiter API</h3>
            <p class="text-gray-600 mb-4 flex-1">Multi-tenant rate-limited public API (token bucket + sliding window). The backend skill big-tech interviews probe.</p>
            <div class="flex gap-2">
              <a href="https://github.com/XDEMONXHEARTX/rate-limiter-api" target="_blank" rel="noopener" class="text-sm text-teal-600 hover:underline">GitHub</a>
            </div>
          </article>

          <!-- Tiny Redis -->
          <article class="bg-white rounded-xl border border-gray-200 p-6 hover:border-teal-300 hover:shadow-lg transition-all duration-300 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class="bg-gray-100 text-gray-800 text-xs font-semibold px-3 py-1 rounded-full">Systems</span>
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">Tiny Redis</h3>
            <p class="text-gray-600 mb-4 flex-1">Reimplement a minimal Redis-compatible server (RESP protocol, GET/SET/EXPIRE). Clone-a-real-system systems chops.</p>
            <div class="flex gap-2">
              <a href="https://github.com/XDEMONXHEARTX/tiny-redis" target="_blank" rel="noopener" class="text-sm text-teal-600 hover:underline">GitHub</a>
            </div>
          </article>
        </div>
        
        <div class="text-center mt-10">
          <a href="/projects" class="inline-flex items-center gap-2 bg-navy-900 text-white px-8 py-4 rounded-lg font-semibold hover:bg-navy-800 transition-colors">
            View All Projects →
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-navy-900 text-white">
      <div class="max-w-3xl mx-auto px-4 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">Ready to talk?</h2>
        <p class="text-lg text-teal-100 mb-8">Six resumes. One portfolio. Let's find the right fit.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="mailto:hire@xdemonxheartx.dev" class="bg-white text-navy-900 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            Email Me
          </a>
          <a href="https://github.com/XDEMONXHEARTX" target="_blank" rel="noopener" class="bg-transparent border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/10 transition-colors">
            GitHub
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>