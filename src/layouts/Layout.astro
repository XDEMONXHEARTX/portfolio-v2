---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      :root {
        --bg: #070b16;
        --bg-soft: #0c1322;
        --surface: #111a2e;
        --surface-2: #16203a;
        --border: rgba(148, 163, 184, 0.14);
        --text: #e2e8f0;
        --muted: #94a3b8;
        --teal: #0F8B8B;
        --teal-bright: #2dd4bf;
        --accent: #38bdf8;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: 'Calibri', 'Segoe UI', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      ::selection { background: var(--teal); color: #04121a; }

      /* ---- aurora backdrop ---- */
      .aurora {
        position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none;
        background:
          radial-gradient(40rem 40rem at 15% -10%, rgba(15,139,139,0.18), transparent 60%),
          radial-gradient(36rem 36rem at 90% 10%, rgba(56,189,248,0.12), transparent 55%),
          radial-gradient(30rem 30rem at 50% 110%, rgba(45,212,191,0.10), transparent 60%),
          var(--bg);
      }
      .aurora::after {
        content: ""; position: absolute; inset: -50%;
        background: conic-gradient(from 0deg at 50% 50%, transparent, rgba(15,139,139,0.06), transparent 30%);
        animation: spin 28s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }

      /* ---- gradient text ---- */
      .grad-text {
        background: linear-gradient(100deg, var(--teal-bright), var(--accent) 55%, #a78bfa);
        -webkit-background-clip: text; background-clip: text; color: transparent;
        background-size: 200% auto; animation: shimmer 6s ease-in-out infinite;
      }
      @keyframes shimmer { 0%,100% { background-position: 0% center; } 50% { background-position: 100% center; } }

      /* ---- scroll reveal ---- */
      .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); }
      .reveal.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        .aurora::after, .grad-text { animation: none; }
      }

      /* ---- glowing card ---- */
      .glow-card {
        position: relative; background: var(--surface);
        border: 1px solid var(--border); border-radius: 1rem;
        transition: transform .35s cubic-bezier(.16,1,.3,1), border-color .35s, box-shadow .35s;
      }
      .glow-card:hover {
        transform: translateY(-6px);
        border-color: rgba(45,212,191,0.45);
        box-shadow: 0 18px 50px -20px rgba(15,139,139,0.55);
      }
      .glow-card::before {
        content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1px;
        background: linear-gradient(130deg, transparent, rgba(45,212,191,0.5), transparent);
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity .35s;
      }
      .glow-card:hover::before { opacity: 1; }

      .pill { background: rgba(15,139,139,0.12); border: 1px solid rgba(45,212,191,0.25); color: var(--teal-bright); }
    </style>
  </head>
  <body class="flex flex-col min-h-screen">
    <div class="aurora"></div>
    <script is:inline>
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
    <slot />
  </body>
</html>